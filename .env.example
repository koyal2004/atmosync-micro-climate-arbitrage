# AtmoSync - Local Environment Configuration Example
# Copy this file to `.env` to override default local settings.
# Do NOT put real credentials or commit `.env` to version control.

ATMOSYNC_APP_ENV=academic-local
ATMOSYNC_LOG_LEVEL=INFO
ATMOSYNC_DB_PATH=database/atmosync.db
ATMOSYNC_DATA_DIR=data
ATMOSYNC_RANDOM_SEED=42
ATMOSYNC_DEFAULT_RECORDS=10000
